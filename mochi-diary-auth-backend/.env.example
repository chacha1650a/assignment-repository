# Postgres 연결 문자열. Neon(무료) 같은 관리형 서비스에서 프로젝트를 만들면 발급됩니다.
# 이 값은 비밀번호가 들어있으니 실제 값은 .env 에만 두고, 여기 이 파일(.env.example)에는 자리표시자만 둡니다.
DATABASE_URL=postgres://user:password@host:5432/dbname

# 세션 토큰을 DB에 저장할 때 쓰는 서버 전용 비밀키 (긴 랜덤 값으로 바꾸세요)
# 예: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=change-me-to-a-long-random-value
PORT=3100
SESSION_TTL_HOURS=12
BCRYPT_ROUNDS=12
